	(gr_text "mas grande los pads del power switch "
		(at 88.1 41.5 0)
		(layer "Cmts.User")
		(uuid "873ec5c3-fa16-4492-ad8d-f5b1b7e3b842")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "El NS8002 consume picos, habria que separarlo de la parte de audio.\nMEJORAR:\n* Zona de Potencia: Batería, cargador MCP73831 y el amplificador NS8002.\n* Zona Digital/Audio Fino: RP2040, regulador de 3.3V y el DAC PT8211.\n\nEl truco es que las corrientes pesadas del NS8002 fluyan directo hacia la batería sin necesidad de pasar por {dblquote}debajo{dblquote} del RP2040 o del PT8211. Si el amplificador está en un extremo de la placa y la batería en el otro, y pones el DAC en el medio, toda la corriente ruidosa del parlante cruzará por debajo del DAC, arruinando el sonido.\n## 2. El {dblquote}Anclaje{dblquote} de los capacitores del NS8002\nEl pin de GND del NS8002 no debe ir {dblquote}suelto{dblquote} al plano de tierra a través de una vía fina.\n"
		(at 143.2 40.4 0)
		(layer "Cmts.User")
		(uuid "f8edbdce-06d3-4e30-b069-8328f1981589")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "agregar cap 220uF en +3.3V cerca del PT8211\nen Vswitch tambien baja el ruido cuando esta enchufado USB"
		(at 8.2 117.1 0)
		(layer "Cmts.User")
		(uuid "edf40d8e-0d28-4baa-8c90-957e25679ba0")
		(effects
			(font
				(size 2 2)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
